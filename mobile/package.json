  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "build:apk": "cd android && gradlew assembleRelease",
    "build:apk:arm64": "cd android && gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "build:bundle": "cd android && gradlew bundleRelease",
    "prebuild:ios": "expo prebuild --platform ios",
    "build:ios": "npx eas-cli build --platform ios",
    "build:ios:sim": "npx eas-cli build --platform ios --profile preview-simulator",
    "build:ios:preview": "npx eas-cli build --platform ios --profile preview",
    "build:ios:prod": "npx eas-cli build --platform ios --profile production"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
