# Server
NODE_ENV=development
PORT=5000

# PostgreSQL
# Use your provider's pooled URL for runtime and direct URL for Prisma migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DIRECT_URL=

# Replace both values with unique, randomly generated secrets in every environment.
JWT_SECRET=replace-with-a-unique-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-unique-random-secret

# Optional integrations
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
STREAM_API_KEY=
STREAM_API_SECRET=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=en-NG-EzinneNeural
RESEND_API_KEY=

# Cloudflare R2 avatar image storage
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_DOMAIN=

# Notifications: EXPO_ACCESS_TOKEN is required when enabled in production.
EXPO_ACCESS_TOKEN=
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_WORKER_ENABLED=true
NOTIFICATIONS_DISPATCH_INTERVAL_MS=15000
NOTIFICATIONS_BATCH_SIZE=50
NOTIFICATIONS_MAX_ATTEMPTS=5
NOTIFICATIONS_RECEIPT_DELAY_MS=900000
NOTIFICATIONS_DEFAULT_TIMEZONE=Africa/Lagos
NOTIFICATIONS_DEFAULT_QUIET_START=21:00
NOTIFICATIONS_DEFAULT_QUIET_END=08:00
NOTIFICATIONS_MAX_PER_DAY=3
NOTIFICATIONS_GLOBAL_MAX_PER_DAY=10
NOTIFICATIONS_RETENTION_DAYS=90
NOTIFICATIONS_LOCK_TIMEOUT_MS=120000
NOTIFICATIONS_MAX_IGNORED_WINBACKS=2
