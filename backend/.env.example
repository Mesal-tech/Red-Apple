# Server
NODE_ENV=development
PORT=5000

# PostgreSQL
# Use your provider's pooled URL for runtime and direct URL for Prisma migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DIRECT_URL=

# Replace both values with unique, randomly generated secrets in every environment.
JWT_SECRET=replace-with-a-unique-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-unique-random-secret

# Optional integrations
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
STREAM_API_KEY=
STREAM_API_SECRET=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=en-NG-EzinneNeural
RESEND_API_KEY=
